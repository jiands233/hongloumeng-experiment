[
  {
    "id": "N038-1-0001",
    "chapter": 38,
    "title": "林瀟湘魁奪菊花詩　薛蘅蕪諷和螃蟹詠",
    "source": "Dream-of-Red-Chamber-master/脂硯齋重評石頭記/chapters/chapter38.tex",
